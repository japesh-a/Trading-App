# Copy to .env or export in your shell. Every value is optional for local work:
# with none set, the app runs with guest accounts, a local SQLite file and the labelled synthetic training feed.
# Never commit real keys. Never put keys in public/ files.

# --- Storage (SQLite only; a hosted PostgreSQL adapter is not built yet) ---
# Set to true once the data directory is on a persistent disk; production start-up warns otherwise.
# WICKLUME_PERSISTENT_DISK=true

# --- Security ---
# Verified/ranked results need a signed-in account. Set to true ONLY to let anonymous
# device sessions qualify again (legacy behaviour, not recommended).
# WICKLUME_ANONYMOUS_VERIFIED=false
# The old shared-progress endpoints (/api/progress, /api/answer, /api/decision) are on in
# development and return 410 in production. Set true/false to override.
# WICKLUME_LEGACY_PROGRESS=false

# --- Server ---
# WICKLUME_PORT=5173
# WICKLUME_HOST=127.0.0.1
# WICKLUME_DATA_DIR=./data
# WICKLUME_DB=./data/wicklume.db
# NODE_ENV=development

# --- Cross-site hosting (only if frontend and API are on different sites) ---
# WICKLUME_ALLOWED_ORIGIN=
# WICKLUME_COOKIE_SECURE=true
# WICKLUME_COOKIE_SAME_SITE=none

# --- Google sign-in (feature flag: button appears only when set; no client secret needed) ---
# Use the OAuth *client ID* (ends in .apps.googleusercontent.com), never the client secret.
# Add your site's origin under "Authorised JavaScript origins" in Google Cloud and to WICKLUME_ALLOWED_ORIGIN.
# GOOGLE_CLIENT_ID=
# Set to false for a Google-only pilot: email/password sign up is refused, existing logins still work.
# Google verifies an email address, not the learner's age.
# WICKLUME_PASSWORD_SIGNUP=true

# --- Market data (feature flag: without a key those instruments use synthetic training mode) ---
# TWELVE_DATA_API_KEY=
# TWELVE_DATA_US500_SYMBOL=

# --- AI trade review (feature flag: set BOTH or AI review stays off) ---
# OPENAI_API_KEY=
# OPENAI_MODEL=

# --- Hosting (see docs/HOSTING.md) ---
# Label shown by /healthz: development, staging or production.
# WICKLUME_ENV=staging
# Build identifier shown by /healthz, for example the git commit SHA set at deploy time.
# WICKLUME_VERSION=

# --- Browser chart tests only ---
# CHROME_PATH=
